---
import Base from './Base.astro';

// Shared chrome for the legal documents under src/content/legal/. Deliberately
// separate from the scoped .doc styles in pages/tos-compliance.astro: that page
// is a hand-built transparency one-pager, this layout styles rendered Markdown.
// Both are document pages and share the brand's sheet treatment, but neither
// depends on the other.
interface Props {
  title: string;
  description: string;
  entity: string;
  version: string;
  effectiveDate: Date;
  noindex?: boolean;
  kicker?: string;
}

const { title, description, entity, version, effectiveDate, noindex = false, kicker } = Astro.props;

// Format in UTC so a date-only frontmatter value never shifts a day backwards
// for anyone west of Greenwich.
const effective = effectiveDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

const path = Astro.url.pathname.replace(/\/$/, '');
---

<Base title={`${title} · Harbor`} description={description} noindex={noindex}>
  <section class="legal">
    <div class="container legal-sheet">
      <div class="legal-toolbar">
        <span class="legal-kicker">{kicker ?? `${entity} · Version ${version}`}</span>
        <button id="print-btn" type="button" class="btn btn-ghost btn-sm no-print">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9V2h12v7M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2M6 14h12v8H6z" /></svg>
          Download PDF
        </button>
      </div>

      <h1>{title}</h1>
      <p class="legal-meta">
        <strong>{entity}</strong>
        <span class="legal-dot" aria-hidden="true">·</span>
        Version {version}
        <span class="legal-dot" aria-hidden="true">·</span>
        Effective <time datetime={effectiveDate.toISOString().slice(0, 10)}>{effective}</time>
      </p>

      <div class="legal-prose">
        <slot />
      </div>

      <p class="print-only legal-print-foot">harborlauncher.com{path} · a product of Paracosm</p>
    </div>
  </section>
</Base>

<style is:global>
  /* ----- Legal document layout (/terms, /privacy) ----- */
  .legal { background: var(--harbor-deep); }
  .legal-sheet { max-width: 820px; margin: 0 auto; padding: 56px 0 96px; }
  .legal-toolbar {
    display: flex; align-items: center; justify-content: space-between;
    gap: 16px; margin-bottom: 40px; flex-wrap: wrap;
  }
  .legal-kicker { font-family: var(--font-mono); font-size: 12px; color: var(--text3); letter-spacing: 0.02em; }

  .legal h1 {
    font-family: var(--font-display); font-weight: 800; font-size: 40px;
    letter-spacing: -0.02em; line-height: 1.08; margin: 0 0 14px; color: var(--text);
  }
  .legal-meta {
    font-family: var(--font-mono); font-size: 12.5px; color: var(--text3);
    margin: 0 0 8px; padding-bottom: 28px; border-bottom: 1px solid var(--harbor-line);
  }
  .legal-meta strong { color: var(--text2); font-weight: 500; }
  .legal-dot { padding: 0 6px; opacity: 0.5; }

  /* ----- Rendered Markdown ----- */
  .legal-prose { font-family: var(--font-body); color: var(--text); }

  .legal-prose h2 {
    font-family: var(--font-display); font-weight: 700; font-size: 13px;
    text-transform: uppercase; letter-spacing: 0.1em; color: var(--teal);
    margin: 52px 0 18px; padding-bottom: 12px;
    border-bottom: 1px solid var(--harbor-line);
  }
  .legal-prose h3 {
    font-family: var(--font-display); font-weight: 700; font-size: 15px;
    letter-spacing: -0.01em; color: var(--text); margin: 34px 0 12px;
  }

  .legal-prose p {
    font-size: 15.5px; line-height: 1.75; color: var(--text2);
    margin: 0 0 14px; max-width: 720px;
  }
  /* Defined terms and the clauses that carry weight sit at full ink. */
  .legal-prose strong { color: var(--text); font-weight: 600; }

  .legal-prose ul,
  .legal-prose ol { margin: 0 0 16px; padding-left: 22px; max-width: 720px; }
  .legal-prose li { font-size: 15.5px; line-height: 1.7; color: var(--text2); margin-bottom: 7px; }
  .legal-prose li::marker { color: var(--text3); }

  .legal-prose a { color: var(--teal); text-decoration: underline; text-underline-offset: 2px; }
  .legal-prose a:hover { text-decoration-thickness: 2px; }

  .legal-prose blockquote {
    margin: 18px 0 20px; padding: 4px 0 4px 20px;
    border-left: 2px solid var(--teal-border); background: none;
  }
  .legal-prose blockquote p { color: var(--text2); font-size: 15px; }
  .legal-prose blockquote p:last-child { margin-bottom: 0; }

  /* Section separators. The h2 already carries a rule, so the source's
     horizontal rules act as breathing room rather than a second line. */
  .legal-prose hr { border: 0; height: 0; margin: 34px 0 0; }

  .legal-prose table {
    width: 100%; max-width: 720px; border-collapse: collapse;
    margin: 4px 0 22px; font-size: 14px;
  }
  .legal-prose th,
  .legal-prose td {
    text-align: left; padding: 10px 14px 10px 0;
    border-bottom: 1px solid var(--harbor-line); vertical-align: top;
  }
  .legal-prose th {
    font-family: var(--font-mono); font-size: 11.5px; font-weight: 500;
    text-transform: uppercase; letter-spacing: 0.06em; color: var(--text3);
    border-bottom-color: var(--harbor-line-strong);
  }
  .legal-prose td { color: var(--text2); line-height: 1.6; }

  .print-only { display: none; }
  .legal-print-foot { margin-top: 48px; font-family: var(--font-mono); font-size: 11px; }

  @media (max-width: 760px) {
    .legal-sheet { padding: 40px 0 72px; }
    .legal h1 { font-size: 30px; }
    /* Wide annex tables scroll rather than forcing the page sideways. */
    .legal-prose table { display: block; overflow-x: auto; white-space: nowrap; }
    .legal-prose td { white-space: normal; min-width: 150px; }
  }

  /* ----- Print: a clean black-on-white contract. Palette is deliberately
     separate from the dark-theme screen tokens. ----- */
  @media print {
    @page { margin: 18mm 16mm; }
    html, body {
      background: #ffffff !important;
      color: #14171c !important;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
    .site-header, .footer, .no-print { display: none !important; }
    .legal, .legal-sheet { background: #fff !important; max-width: none; padding: 0; }
    .legal h1 { color: #0a0c10 !important; font-size: 26px; }
    .legal-meta { color: #6b7280 !important; border-color: #d8dde3 !important; }
    .legal-meta strong { color: #3a4049 !important; }
    .legal-prose h2 { color: #0a8f60 !important; border-color: #d8dde3 !important; break-after: avoid; }
    .legal-prose h3 { color: #0a0c10 !important; break-after: avoid; }
    .legal-prose p,
    .legal-prose li { color: #14171c !important; font-size: 10.5pt; line-height: 1.5; }
    .legal-prose strong { color: #0a0c10 !important; }
    .legal-prose a { color: inherit !important; text-decoration: none !important; }
    .legal-prose blockquote { border-left-color: #0a8f60 !important; }
    .legal-prose blockquote p { color: #3a4049 !important; }
    .legal-prose th { color: #6b7280 !important; border-bottom-color: #b9c0c8 !important; }
    .legal-prose td { color: #14171c !important; border-bottom-color: #d8dde3 !important; }
    .legal-prose table { display: table !important; white-space: normal !important; break-inside: avoid; }
    .legal-kicker, .legal-print-foot { color: #6b7280 !important; }
    .print-only { display: block !important; }
  }
</style>

<script>
  document.getElementById('print-btn')?.addEventListener('click', () => window.print());
</script>
