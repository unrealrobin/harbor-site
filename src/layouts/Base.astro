---
import '../styles/fonts.css';
import '../styles/global.css';
import PostHog from '../components/posthog.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { shouldLoadAnalytics } from '../lib/analytics';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Harbor · Sell the game. Keep the player.',
  description = 'Harbor is a white-label launcher that ships with your game. Every time a player hits Play, they pass through a screen you own: your news, your surveys, and an email list you keep.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;

// Analytics: resolved at build time. Render PostHog only on the Netlify
// production deploy (see src/lib/analytics.ts). The snippet itself lives in
// src/components/posthog.astro.
const loadAnalytics = shouldLoadAnalytics(process.env.CONTEXT);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* PostHog — rendered on the Netlify production deploy only. The snippet
        is the official is:inline component (src/components/posthog.astro). */}
    {loadAnalytics && <PostHog />}

    <!-- Fonts: self-hosted woff2 (see src/styles/fonts.css). Preload the two
         faces used above the fold; mono loads on demand. -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/archivo-expanded-var.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/archivo-var.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/jetbrains-mono-var.woff2" crossorigin />
    <noscript>
      <style>
        /* JS off → no observer will ever reveal data-rv elements; show them. */
        [data-rv] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
