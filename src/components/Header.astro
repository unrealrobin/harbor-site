---
// Sticky site header with a mobile hamburger menu (≤760px). Nav links only
// point at routes that exist today.
const EARLY_ACCESS_MAILTO =
  "mailto:earlyaccess@paracosm.gg?subject=Harbor%20early%20access";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="site-header" id="site-header">
  <div class="container site-header-inner">
    <a href="/" class="logo"><span class="logo-mark"></span> Harbor</a>

    <button
      type="button"
      class="nav-toggle"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="primary-nav"
    >
      <svg class="nav-toggle-bars" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      <svg class="nav-toggle-x" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
    </button>

    <div class="nav-collapse" id="primary-nav">
      <nav class="nav-links" aria-label="Primary">
        <a href="/#what" class="nav-link">What it is</a>
        <a
          href="/how-it-works"
          class:list={["nav-link", { "is-active": path === "/how-it-works" }]}
          >How it works</a
        >
        <a
          href="/early-access"
          class:list={["nav-link", { "is-active": path === "/early-access" }]}
          >Early access</a
        >
        <a href="/docs" class="nav-link">Docs</a>
      </nav>
      <div class="nav-right">
        <a href={EARLY_ACCESS_MAILTO} class="btn btn-primary btn-sm">Get early access</a>
      </div>
    </div>
  </div>
</header>

<script>
  // Mobile nav toggle. The dropdown (#primary-nav) is display:none on mobile
  // until the header gets [data-open]; on desktop it's display:contents and this
  // sits idle. Closes on link click, Escape, and resize back to desktop.
  const header = document.getElementById("site-header");
  const toggle = header?.querySelector<HTMLButtonElement>(".nav-toggle");
  const panel = document.getElementById("primary-nav");

  if (header && toggle && panel) {
    const setOpen = (open: boolean) => {
      header.toggleAttribute("data-open", open);
      toggle.setAttribute("aria-expanded", String(open));
    };

    toggle.addEventListener("click", () => {
      setOpen(!header.hasAttribute("data-open"));
    });

    // Follow a nav link → close the menu.
    panel.querySelectorAll("a").forEach((a) => {
      a.addEventListener("click", () => setOpen(false));
    });

    // Escape closes and returns focus to the toggle.
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && header.hasAttribute("data-open")) {
        setOpen(false);
        toggle.focus();
      }
    });

    // Tap/click outside the header closes the menu. The toggle and links live
    // inside <header>, so opening and link-clicks don't trip this.
    document.addEventListener("click", (e) => {
      if (header.hasAttribute("data-open") && !header.contains(e.target as Node)) {
        setOpen(false);
      }
    });

    // Grow back to desktop → reset, so the menu can't be stuck open.
    window.addEventListener("resize", () => {
      if (window.innerWidth > 760 && header.hasAttribute("data-open")) {
        setOpen(false);
      }
    });
  }
</script>
