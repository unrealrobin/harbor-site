---
// "Why Harbor" — the ownership section, north-star composition: heading +
// lede left, the four value claims as numbered hairline rows right. Followed
// by the polarity flip ("But every one of them presses Play.") — the page's
// SINGLE light section (brand doc: one flip per page, it's drama because
// it's rare).
// Authored, trusted content — `line` renders via set:html so the Valve quote
// can be italicized. Do NOT source this from untrusted input (CMS/API/build
// data) without escaping first.
const VALUE_ITEMS = [
  {
    claim: 'A relationship you own.',
    line: "On Steam, your audience lives on Valve's servers, under Valve's rules. Harbor moves it onto a surface that belongs to you.",
  },
  {
    claim: 'Player emails, for the first time.',
    line: 'Steam shows you totals and regions, never a player you can actually reach. Harbor gives you player-level contact: an email list you can export.',
  },
  {
    claim: 'Guaranteed to be seen.',
    line: 'Even Valve says it: <em>“Not all of your customers will see your event…”</em> Harbor sits on the one screen every player passes through, every session.',
  },
  {
    claim: 'Yours to take anywhere.',
    line: 'Nothing Steam gives you follows you off Steam. With Harbor, your list and your data leave with you: to your next game, your next platform.',
  },
];
---

<section class="why" aria-labelledby="why-title">
  <div class="container why-cols">
    <div class="why-head" data-rv style="--rv: translateX(-36px)">
      <span class="eyebrow">Why Harbor</span>
      <h2 class="why-title" id="why-title">
        You sold the game. <span class="dim">You never got the player.</span>
      </h2>
      <p class="lede">
        Distributors sell your game and own the relationship with the player.
        Harbor hands it back:
      </p>
    </div>

    <div class="row-list" data-rv-group>
      {
        VALUE_ITEMS.map((p, i) => (
          <div class="row" data-rv style="--rv: translateX(36px)">
            <span class="row-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="row-title">{p.claim}</h3>
              <p class="row-desc" set:html={p.line} />
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- The polarity flip — the page's single light section. -->
<section class="flip" aria-labelledby="flip-title">
  <div class="container" data-rv-group>
    <span class="eyebrow flip-eyebrow" data-rv>The moment</span>
    <h2 class="flip-title" id="flip-title" data-rv>But every one of them presses Play.</h2>
    <p class="flip-body" data-rv>
      That launch is the one moment you're <strong>guaranteed their attention</strong>, every session,
      and it's the moment Harbor hands back to you. It's how a one-time buyer becomes
      a <strong>lifelong fan</strong>.
    </p>
    <a href="/early-access#apply" class="flip-cta" data-rv>Get early access</a>
  </div>
</section>

<style is:global>
  .why {
    background: var(--harbor-deep);
    padding: clamp(72px, 8vw, 120px) 0;
  }
  .why-cols {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 4vw;
    align-items: start;
  }
  .why-title {
    font-family: var(--font-display-expanded);
    font-stretch: 125%;
    font-weight: 900;
    font-size: clamp(30px, 3.9vw, 56px);
    line-height: 1.02;
    letter-spacing: -0.022em;
    color: var(--text);
    margin: 0 0 20px;
    text-wrap: balance;
  }
  .why-title .dim { color: var(--text3); }
  .why .lede { max-width: 44ch; }
  /* Mock-exact rows: hairlines between ideas, number as a small accent. */
  .why .row-n {
    color: var(--teal);
    font-size: 11px;
  }

  .flip {
    background: var(--flip-bg);
    color: var(--flip-ink);
    padding: clamp(72px, 10vw, 150px) 0;
  }
  .flip-eyebrow { color: var(--flip-accent); }
  .flip-title {
    font-family: var(--font-display-expanded);
    font-stretch: 125%;
    font-weight: 900;
    font-size: clamp(40px, 7.4vw, 118px);
    line-height: 0.95;
    letter-spacing: -0.028em;
    color: var(--flip-ink);
    margin: 0 0 30px;
    max-width: 12ch;
  }
  .flip-body {
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 1.6;
    color: var(--flip-muted);
    margin: 0 0 34px;
    max-width: 56ch;
  }
  .flip-body strong { color: var(--flip-ink); font-weight: 600; }
  .flip-cta {
    display: inline-block;
    background: var(--teal);
    color: var(--teal-contrast);
    font-family: var(--font-body);
    font-weight: 650;
    font-size: 15px;
    line-height: 1.35;
    padding: 13px 26px;
    border-radius: var(--r-md);
    text-decoration: none;
    transition: opacity var(--dur-base) var(--ease);
  }
  .flip-cta:hover { opacity: 0.85; }
  .flip-cta:focus-visible {
    outline: 2px solid var(--flip-ink);
    outline-offset: 3px;
  }

  @media (max-width: 980px) {
    .why-cols { grid-template-columns: 1fr; gap: 36px; }
  }
  @media (max-width: 760px) {
    .why { padding: 64px 0; }
    .flip { padding: 64px 0; }
  }
</style>
