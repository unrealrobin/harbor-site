---
// "Frictionless for players" — answers the launcher-backlash objection
// proactively, with design facts rather than promises. Links to the
// /tos-compliance page as the long-form proof.
const DESIGN_FACTS = [
  { lead: 'No account, ever.', rest: '' },
  { lead: 'Email is opt-in only.', rest: 'Skip and play.' },
  { lead: 'Skippable in one click,', rest: 'and you can skip it entirely for returning players.' },
  { lead: 'Fail-open.', rest: 'If Harbor ever breaks, your game launches anyway.' },
  { lead: 'Not DRM.', rest: 'Never gates the game, never modifies your files.' },
  { lead: 'No background process.', rest: 'It opens, hands off, and closes.' },
  { lead: 'Steam Deck-safe,', rest: 'built controller-first.' },
  { lead: 'Disclosed.', rest: 'Pitched to players as part of your store page, not sprung on them.' },
];
---

<section class="frictionless" id="frictionless" aria-labelledby="frictionless-title">
  <div class="dotgrid frictionless-grid-bg"></div>
  <div class="container frictionless-inner">
    <div class="section-head">
      <span class="eyebrow eyebrow-blue">Players first</span>
      <h2 class="display-lg" id="frictionless-title">Frictionless for players.</h2>
      <p class="lede" style="margin-top:16px;">
        Players hate launchers that demand a second account, force an email, gate the game behind
        DRM, run in the background, or show up undisclosed. Harbor is designed as the opposite of
        that list:
      </p>
    </div>

    <ul class="fl-list">
      {
        DESIGN_FACTS.map((f) => (
          <li class="fl-item">
            <span class="fl-check" aria-hidden="true">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
            </span>
            <span class="fl-text"><strong>{f.lead}</strong> {f.rest}</span>
          </li>
        ))
      }
    </ul>

    <div class="callout blue fl-close">
      <span class="callout-icon" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 16v-4M12 8h.01" /></svg>
      </span>
      <p class="callout-body">
        Big publishers are retreating from the launcher pattern players hate. <strong>2K pulled its
        launcher from every PC title in 2024.</strong> That pattern is exactly what Harbor was
        designed never to be.
        <a href="/tos-compliance" class="text-blue" style="text-decoration:underline;text-underline-offset:2px;">Read the full transparency page →</a>
      </p>
    </div>
  </div>
</section>

<style>
  .frictionless {
    position: relative;
    background: var(--harbor-halo), var(--harbor-deep);
    border-top: 1px solid var(--harbor-line);
    padding: 104px 0;
    overflow: hidden;
  }
  .frictionless-grid-bg {
    position: absolute;
    inset: 0;
    opacity: 0.45;
    pointer-events: none;
  }
  .frictionless-inner {
    position: relative;
    z-index: 2;
  }
  .fl-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px 28px;
    margin: 40px 0 0;
    padding: 0;
    list-style: none;
    max-width: 880px;
  }
  .fl-item {
    display: flex;
    gap: 13px;
    align-items: flex-start;
    padding: 15px 4px;
    border-top: 1px solid var(--harbor-line);
  }
  .fl-check {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--teal-bg);
    border: 1px solid var(--teal-border);
    color: var(--teal);
    margin-top: 1px;
  }
  .fl-text {
    font-family: var(--font-body);
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--text2);
  }
  .fl-text strong {
    color: var(--text);
    font-weight: 600;
    font-family: var(--font-display);
    font-size: 15px;
  }
  .fl-close {
    margin-top: 44px;
    max-width: 780px;
  }

  @media (max-width: 980px) {
    .fl-list {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 760px) {
    .frictionless {
      padding: 72px 0;
    }
  }
</style>
