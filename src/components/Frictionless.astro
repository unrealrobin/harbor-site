---
// "Frictionless for players" — answers the launcher-backlash objection
// proactively, with design facts rather than promises. Links to the
// /tos-compliance page as the long-form proof.
const DESIGN_FACTS: { lead: string; rest?: string }[] = [
  { lead: 'No account, ever.' },
  { lead: 'Email is opt-in only.', rest: 'Skip and play.' },
  { lead: 'Skippable in one click,', rest: 'and you can skip it entirely for returning players.' },
  { lead: 'Fail-open.', rest: 'If Harbor ever breaks, your game launches anyway.' },
  { lead: 'Not DRM.', rest: 'Never gates the game, never modifies your files.' },
  { lead: 'No launcher updates.', rest: 'Players never wait on a Harbor patch.' },
];
---

<section class="frictionless" id="frictionless" aria-labelledby="frictionless-title">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow fl-eyebrow">Players first</span>
      <h2 class="fl-title" id="frictionless-title">Frictionless for players.</h2>
      <p class="fl-lede">
        Players hate launchers that demand a second account, force an email, gate the game behind
        DRM, run in the background, or show up undisclosed. Harbor is the opposite:
      </p>
    </div>

    <ul class="fl-list">
      {
        DESIGN_FACTS.map((f) => (
          <li class="fl-item">
            <span class="fl-check" aria-hidden="true">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
            </span>
            <span class="fl-text"><strong>{f.lead}</strong>{f.rest && ` ${f.rest}`}</span>
          </li>
        ))
      }
    </ul>

    <div class="callout neutral fl-close">
      <span class="callout-icon" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 16v-4M12 8h.01" /></svg>
      </span>
      <p class="callout-body">
        Big publishers are retreating from the launcher pattern players hate. <strong>2K pulled its
        launcher from every PC title in 2024.</strong> That pattern is exactly what Harbor was
        designed never to be.
        <a href="/tos-compliance" class="fl-link" style="text-decoration:underline;text-underline-offset:2px;">Read the full transparency page →</a>
      </p>
    </div>
  </div>
</section>

<style>
  /* Second light section (Robin, 2026-07-26) — pairs with The Moment; always
     separated from it by at least one dark section. */
  .frictionless {
    background: var(--flip-bg);
    color: var(--flip-ink);
    padding: clamp(72px, 8vw, 110px) 0;
  }
  .fl-eyebrow {
    color: var(--flip-accent);
  }
  .fl-title {
    font-family: var(--font-display-expanded);
    font-stretch: 125%;
    font-weight: 900;
    font-size: clamp(28px, 3.4vw, 48px);
    line-height: 1.04;
    letter-spacing: -0.02em;
    color: var(--flip-ink);
    margin: 0;
    text-wrap: balance;
  }
  .fl-lede {
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 1.6;
    color: var(--flip-muted);
    margin: 16px 0 0;
    max-width: 62ch;
  }
  .fl-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px 28px;
    margin: 40px 0 0;
    padding: 0;
    list-style: none;
    max-width: 880px;
  }
  .fl-item {
    display: flex;
    gap: 13px;
    align-items: flex-start;
    padding: 15px 4px;
    border-top: 1px solid color-mix(in srgb, var(--flip-ink) 12%, transparent);
  }
  .fl-check {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--flip-accent) 9%, transparent);
    border: 1px solid color-mix(in srgb, var(--flip-accent) 32%, transparent);
    color: var(--flip-accent);
    margin-top: 1px;
  }
  .fl-text {
    font-family: var(--font-body);
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--flip-muted);
  }
  .fl-text strong {
    color: var(--flip-ink);
    font-weight: 600;
    font-family: var(--font-display);
    font-size: 15px;
  }
  .fl-close {
    margin-top: 44px;
    max-width: 780px;
  }
  .frictionless :global(.callout.neutral) {
    background: color-mix(in srgb, var(--flip-ink) 4%, transparent);
    border-color: color-mix(in srgb, var(--flip-ink) 15%, transparent);
  }
  .frictionless :global(.callout.neutral .callout-icon) {
    color: var(--flip-muted);
  }
  .frictionless :global(.callout-body) {
    color: var(--flip-muted);
  }
  .frictionless :global(.callout-body strong) {
    color: var(--flip-ink);
  }
  .fl-link {
    color: var(--flip-accent);
  }

  @media (max-width: 980px) {
    .fl-list {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 760px) {
    .frictionless {
      padding: 72px 0;
    }
  }
</style>
