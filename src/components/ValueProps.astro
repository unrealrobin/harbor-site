---
// "What you get back" — the five value props, north-star composition: the
// flagship ("Own your email list") as an editorial lead panel on the left,
// the four supporting props as numbered hairline rows on the right. Proof
// stats render as mono data callouts — specificity is the brand's texture.
// Every stat comes from the approved citations bank in the Notion copy plan.
// Authored, trusted content — `proof` renders via set:html. Do NOT source it
// from untrusted input (CMS/API/build data) without escaping first.
const PROPS: { title: string; body: string; proof: string | null }[] = [
  {
    title: 'Put your community in front of every player',
    body: 'Only a small fraction of your players ever go looking for your Discord. Harbor puts the invite in front of every session: the whole player base, not the self-selected slice.',
    proof: null,
  },
  {
    title: "Your channels, at the moment they're paying attention",
    body: 'Your socials and links, surfaced to every player at launch. The channels that drive indie discovery, in front of the people most likely to share them.',
    proof: null,
  },
  {
    title: 'Hear the quiet majority',
    body: "In most communities, about 1% of players produce most of the feedback, and they're not representative. Harbor surveys reach everyone who plays: anonymous, no login, one click.",
    proof: 'In-context prompts get answered. In-app surveys average a <strong>27.5% response rate</strong>.',
  },
  {
    title: "Momentum for the game you're shipping now",
    body: 'Harbor puts the review-and-wishlist ask in front of your active players, the people most likely to say yes.',
    proof: 'Reviews decide launches: games that hit <strong>200+ reviews</strong> in their first month of Early Access reached 1,000+ by 1.0 in <strong>73% of cases</strong>.',
  },
];
---

<section class="section section-ink" id="value-props">
  <div class="container">
    <div class="section-head" data-rv>
      <span class="eyebrow">What you get back</span>
      <h2 class="display-lg">Five pieces of the player relationship, returned to you.</h2>
      <p class="lede">
        The storefront keeps the relationship aggregate and gated. Harbor hands each piece back,
        starting with the only one you can take with you.
      </p>
    </div>

    <div class="vp-cols">
      <div class="vp-lead" data-rv style="--rv: translateX(-36px)">
        <p class="vp-flag">The flagship · included on every plan</p>
        <h3 class="vp-lead-title">Own your email list</h3>
        <p class="vp-lead-body">
          One opt-in prompt at the moment of play, and you walk away with the thing no storefront
          will ever hand over: your players' actual contacts, in a list you own, export, and keep.
          Always optional for the player, never a gate. Skip it and the game just launches.
        </p>
        <p class="vp-proof">
          One email to an owned list has driven <strong>1,200 wishlists</strong> for an indie
          studio (Failbetter Games).
        </p>
      </div>

      <div class="row-list" data-rv-group>
        {
          PROPS.map((p, i) => (
            <div class="row" data-rv style="--rv: translateX(36px)">
              <span class="row-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="row-title">{p.title}</h3>
                <p class="row-desc">{p.body}</p>
                {p.proof && <p class="vp-proof" set:html={p.proof} />}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .vp-cols {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 4vw;
    align-items: start;
  }
  .vp-lead {
    background: var(--harbor-deep);
    border: 1px solid var(--teal-border);
    border-radius: var(--r-lg);
    padding: 30px 32px 28px;
  }
  .vp-flag {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--teal);
    margin: 0 0 18px;
  }
  .vp-lead-title {
    font-family: var(--font-display-expanded);
    font-stretch: 125%;
    font-weight: 900;
    font-size: clamp(24px, 2.4vw, 32px);
    letter-spacing: -0.018em;
    line-height: 1.05;
    color: var(--text);
    margin: 0 0 14px;
  }
  .vp-lead-body {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.6;
    color: var(--text2);
    margin: 0 0 20px;
  }
  .vp-proof {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.6;
    letter-spacing: 0.02em;
    color: var(--text3);
    margin: 12px 0 0;
  }
  .vp-proof :global(strong),
  .vp-proof strong {
    color: var(--teal);
    font-weight: 500;
  }
  .vp-lead .vp-proof {
    border-top: 1px solid var(--harbor-line);
    padding-top: 16px;
    margin-top: 0;
  }

  @media (max-width: 980px) {
    .vp-cols {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }
</style>
