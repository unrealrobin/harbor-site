---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found · Harbor" description="That page doesn't exist.">
  <section class="hero-int">
    <div class="container">
      <span class="eyebrow">404</span>
      <h1 class="hero-int-title">Page not found.</h1>
      <p class="lede">
        That page doesn't exist, or it moved. Head back to the homepage, or see how Harbor works.
      </p>
      <div class="hero-cta-row" style="margin-top: 28px;">
        <a href="/" class="btn btn-primary btn-lg">Back home</a>
        <a href="/how-it-works" class="btn btn-ghost btn-lg">How it works</a>
      </div>
    </div>
  </section>
</Base>
