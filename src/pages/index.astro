---
import Base from '../layouts/Base.astro';
import WhyHarbor from '../components/WhyHarbor.astro';
import ValueProps from '../components/ValueProps.astro';
import Frictionless from '../components/Frictionless.astro';

const WHAT_BULLETS: { title: string; desc: string; icon: string }[] = [
  {
    title: 'It sits between the storefront and your game',
    desc: 'Steam, Epic, or GOG launches Harbor; Harbor launches your game. Nothing about how players start your game changes.',
    icon: 'M5 12h14M13 6l6 6-6 6',
  },
  {
    title: 'Fully white-label',
    desc: 'Your name, logo, colors, fonts, and play button. There is no Harbor branding shown to your players, ever.',
    icon: 'M8 12l2.5 2.5L16 9',
  },
  {
    title: 'Zero player install',
    desc: "Harbor ships as a file alongside your build. Players don't download anything, sign in to anything, or know it's there.",
    icon: 'M12 3v12M7 10l5 5 5-5M5 21h14',
  },
  {
    title: 'See what lands',
    desc: 'Every module reports engagement: clicks on your Discord link, survey responses, email opt-ins. You know what your players actually do with the moment.',
    icon: 'M3 17l6-6 4 4 8-8M14 7h7v7',
  },
];
---

<Base>
  <!-- ===== Hero ===== -->
  <section class="hero">
    <div class="dotgrid hero-grid"></div>
    <div class="container hero-cols">
      <div class="hero-inner">
        <span class="pill pill-teal" style="margin-bottom:28px;">
          <span class="pill-dot"></span>
          Early access · partner program open
        </span>

        <h1 class="hero-headline">
          Sell the game.<br />
          <span class="text-teal">Keep the player.</span>
        </h1>

        <p class="hero-paragraph">
          Steam sells your game and keeps your players. Harbor is a lightweight, white-label
          launcher that turns the moment the player hits Play into a relationship you own:
          your updates, your community, your surveys.
        </p>

        <p class="hero-keyline">
          <strong class="text-teal">Your players' emails, for the first time:</strong> an opt-in
          list you own, export, and keep.
        </p>

        <p class="hero-trust">
          No player accounts.<span class="sep" aria-hidden="true">·</span>No DRM.<span class="sep" aria-hidden="true">·</span>One
          skippable screen.<span class="sep" aria-hidden="true">·</span>Game launches like it always has.
        </p>

        <form id="waitlist-form" class="email-form">
          <p class="honeypot" aria-hidden="true">
            <label>Don't fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </p>
          <input
            type="email"
            name="email"
            placeholder="you@studio.com"
            required
            aria-label="Email address"
            class="input email-input"
          />
          <button type="submit" class="btn btn-primary btn-lg">Get access</button>
          <span class="form-error" id="waitlist-error" role="alert" hidden></span>
        </form>

        <div class="form-success" id="waitlist-success" role="status" tabindex="-1" hidden>
          <span class="pill pill-teal">
            <span class="pill-dot"></span>
            You're in.
          </span>
          <p class="form-success-msg">We'll be in touch about access.</p>
        </div>
      </div>

      {/* Hero media. Interim still frame; swap the <img> for the short looping
          clip (player opting in / answering a survey) once it's recorded. */}
      <div class="hero-media">
        <button type="button" class="hero-media-frame" id="hero-zoom" aria-haspopup="dialog" aria-label="Enlarge screenshot: a white-label Harbor launcher for the game Die Robot showing news, dev comments, an email opt-in, and a Play button">
          <img src="/demo-poster.webp" alt="A white-label Harbor launcher for the game Die Robot showing news, dev comments, an email opt-in, and a Play button" loading="eager" decoding="async" />
          <span class="hero-zoom-hint" aria-hidden="true">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3M11 8v6M8 11h6" /></svg>
            Enlarge
          </span>
        </button>
        <span class="hero-media-chip"><span class="pill-dot" aria-hidden="true"></span> Your launcher, at the moment of Play</span>
        <dialog class="hero-lightbox" id="hero-lightbox" aria-label="Launcher screenshot, enlarged">
          <img src="/demo-poster.webp" alt="A white-label Harbor launcher for the game Die Robot showing news, dev comments, an email opt-in, and a Play button" loading="lazy" decoding="async" />
          <button type="button" class="hero-lightbox-close" id="hero-lightbox-close" aria-label="Close enlarged screenshot">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
          </button>
        </dialog>
      </div>
    </div>
  </section>

  <!-- ===== Why Harbor ===== -->
  <WhyHarbor />

  <!-- ===== What you get back ===== -->
  <ValueProps />

  <!-- ===== What is Harbor ===== -->
  <section class="section section-ink" id="what">
    <div class="container">
      <div class="grid" style="grid-template-columns:1fr 1fr;gap:56px;align-items:center;" data-stack>
        <div>
          <span class="eyebrow">What is Harbor</span>
          <h2 class="display-lg" style="margin-bottom:18px;">A surface you own, at the moment that matters.</h2>
          <p class="lede" style="margin-bottom:28px;">
            Your players already open your game several times a week. Harbor turns that launch moment
            into a channel you control. Show a patch note, drop a beta invite, or just say something
            in your own voice. It's the part of the player relationship the storefront keeps for itself.
          </p>
          <ul class="feature-list">
            {
              WHAT_BULLETS.map((b) => (
                <li class="feature-item">
                  <span class="feature-bullet" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={b.icon} /></svg>
                  </span>
                  <div>
                    <p class="feature-title">{b.title}</p>
                    <p class="feature-desc">{b.desc}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <div class="flow" aria-label="Storefront launches Harbor, Harbor launches your game">
            <div class="flow-node">
              <div class="flow-node-label">Storefront</div>
              <div class="flow-node-sub">Steam · Epic · GOG</div>
            </div>
            <div class="flow-arrow" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </div>
            <div class="flow-node is-harbor">
              <div class="flow-node-label text-teal">Harbor</div>
              <div class="flow-node-sub">your branded launcher</div>
            </div>
            <div class="flow-arrow" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </div>
            <div class="flow-node">
              <div class="flow-node-label">Your game</div>
              <div class="flow-node-sub">launches as normal</div>
            </div>
          </div>
          <div class="callout plain" style="margin-top:20px;">
            <span class="callout-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 8h.01M11 12h1v4h1" /></svg>
            </span>
            <p class="callout-body">The player's experience is one extra screen they can skip in one click. The studio gets <strong>the relationship the storefront was keeping for itself.</strong></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Frictionless for players ===== -->
  <Frictionless />

  <!-- ===== FAQ pointer ===== -->
  <section class="section faq-pointer">
    <div class="container" style="text-align:center;max-width:640px;">
      <span class="eyebrow">FAQ</span>
      <p class="lede" style="margin-bottom:24px;">
        Pricing, storefront rules, player experience: things devs ask us, answered.
      </p>
      <a href="/how-it-works#faq" class="btn btn-ghost btn-lg">Read the FAQ →</a>
    </div>
  </section>
</Base>

<style>
  .hero-cols {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .hero-cols .hero-inner {
    position: static;
    max-width: none;
  }
  .hero-keyline {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.45;
    color: var(--text);
    letter-spacing: -0.01em;
    margin: 0 0 18px;
  }
  .hero-trust {
    font-family: var(--font-display);
    font-size: 14.5px;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.01em;
    margin: 0 0 34px;
  }
  .hero-trust .sep {
    color: var(--text3);
    font-weight: 400;
    margin: 0 7px;
  }
  .hero-media-frame {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid var(--teal-border);
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--harbor-ink);
    box-shadow:
      0 24px 80px rgba(0, 0, 0, 0.45),
      0 0 44px var(--teal-glow);
    cursor: zoom-in;
  }
  .hero-media-frame:focus-visible {
    outline: 2px solid var(--teal);
    outline-offset: 3px;
  }
  .hero-media-frame img {
    display: block;
    width: 100%;
    height: auto;
  }
  .hero-zoom-hint {
    position: absolute;
    right: 12px;
    bottom: 12px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-display);
    font-size: 11.5px;
    font-weight: 600;
    color: var(--text);
    background: rgba(10, 12, 16, 0.6);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: 1px solid var(--harbor-line);
    border-radius: var(--r-pill);
    padding: 5px 11px;
    pointer-events: none;
  }
  .hero-lightbox {
    max-width: min(1180px, 92vw);
    padding: 0;
    border: 1px solid var(--harbor-line-strong);
    border-radius: var(--r-lg);
    background: var(--harbor-ink);
    overflow: hidden;
  }
  .hero-lightbox::backdrop {
    background: rgba(10, 12, 16, 0.8);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }
  /* Native <dialog> doesn't lock background scroll on its own. */
  :global(body:has(.hero-lightbox[open])) {
    overflow: hidden;
  }
  .hero-lightbox img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 88vh;
    object-fit: contain;
  }
  .hero-lightbox-close {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid var(--harbor-line-strong);
    background: rgba(10, 12, 16, 0.7);
    color: var(--text);
    cursor: pointer;
    transition: border-color var(--dur-base) var(--ease);
  }
  .hero-lightbox-close:hover {
    border-color: var(--teal-border);
  }
  .hero-lightbox-close:focus-visible {
    outline: 2px solid var(--teal);
    outline-offset: 2px;
  }
  .hero-media-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
    font-family: var(--font-display);
    font-size: 12.5px;
    font-weight: 600;
    color: var(--text2);
  }
  .faq-pointer {
    border-top: 1px solid var(--harbor-line);
    padding: 72px 0;
  }

  @media (max-width: 980px) {
    .hero-cols {
      grid-template-columns: 1fr;
      gap: 44px;
    }
    .hero-media {
      max-width: 640px;
    }
  }
  @media (max-width: 760px) {
    .faq-pointer {
      padding: 56px 0;
    }
  }
</style>

<script>
  // Wire the hero waitlist form to the /api/subscribe Netlify Function (adds the
  // email to the Resend Audience). On success, swap the form for the success
  // state; on failure, show a readable error. PostHog (production-only) is
  // optional-chained.
  function wireForm(formId: string, successId: string, errorId: string, location: string) {
    const form = document.getElementById(formId) as HTMLFormElement | null;
    const success = document.getElementById(successId);
    const errorEl = document.getElementById(errorId);
    if (!form) return;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const fields = new FormData(form);
      const payload = {
        email: String(fields.get('email') ?? ''),
        'bot-field': String(fields.get('bot-field') ?? ''),
      };

      button.disabled = true;
      button.textContent = 'Sending…';
      errorEl?.setAttribute('hidden', '');

      try {
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const result = (await res.json().catch(() => ({ ok: false, error: '' }))) as {
          ok?: boolean;
          error?: string;
        };
        if (!res.ok || !result.ok) {
          throw new Error(result.error || 'Something went wrong. Try again?');
        }
        // Event name frozen for analytics continuity (button copy has changed
        // since launch); renaming it would fork the PostHog funnel history.
        window.posthog?.capture('notify_me_submit', { location });
        form.setAttribute('hidden', '');
        success?.removeAttribute('hidden');
        (success as HTMLElement | null)?.focus();
      } catch (err) {
        if (errorEl) {
          errorEl.textContent = err instanceof Error ? err.message : 'Something went wrong. Try again?';
          errorEl.removeAttribute('hidden');
        }
        button.disabled = false;
        button.textContent = 'Get access';
      }
    });
  }

  wireForm('waitlist-form', 'waitlist-success', 'waitlist-error', 'hero');

  // Hero screenshot lightbox. Native <dialog> supplies Esc-to-close, focus
  // trapping, and the backdrop; we only wire open, close, and backdrop clicks.
  const zoomBtn = document.getElementById('hero-zoom');
  const lightbox = document.getElementById('hero-lightbox') as HTMLDialogElement | null;
  const closeBtn = document.getElementById('hero-lightbox-close');
  if (zoomBtn && lightbox && typeof lightbox.showModal === 'function') {
    zoomBtn.addEventListener('click', () => lightbox.showModal());
    closeBtn?.addEventListener('click', () => lightbox.close());
    lightbox.addEventListener('click', (event) => {
      // Clicks on the backdrop register with the <dialog> itself as target.
      if (event.target === lightbox) lightbox.close();
    });
  }
</script>
