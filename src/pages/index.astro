---
import Base from '../layouts/Base.astro';
import WhyHarbor from '../components/WhyHarbor.astro';
import ValueProps from '../components/ValueProps.astro';
import Frictionless from '../components/Frictionless.astro';

// Hero explainer video (youtube.com/watch?v=6ioKU36dQYk).
const HERO_VIDEO_ID = '6ioKU36dQYk';

// Module names surface here so a first-time visitor sees the feature set
// without leaving the homepage. Keep in sync with MODULES on /how-it-works.
const MODULE_NAMES = ['Email Capture', 'Patch Notes', 'News', 'Dev Comments', 'Surveys', 'Analytics'];

const WHAT_BULLETS: { title: string; desc: string; modules?: string[] }[] = [
  {
    title: 'It sits between the storefront and your game',
    desc: 'Steam, Epic, or GOG launches Harbor; Harbor launches your game. Nothing about how players start your game changes.',
  },
  {
    title: 'Fully white-label',
    desc: 'Your name, logo, colors, fonts, and play button. There is no Harbor branding shown to your players, ever.',
  },
  {
    title: 'Zero player install',
    desc: "Harbor ships as a file alongside your build. Players don't download anything, sign in to anything, or know it's there.",
  },
  {
    title: 'Module library',
    desc: 'A growing library of plug-and-play modules that do the player-engagement work for you. Turn on whatever fits your game. New modules land every few patches.',
    modules: MODULE_NAMES,
  },
];
---

<Base>
  <!-- ===== Hero ===== -->
  <section class="hero-xl">
    <h1 class="hero-display">
      Own the moment <span class="hd-alt">of Play.</span>
    </h1>
    <div class="hero-cols">
      <div class="hero-copy">
        <p class="hero-paragraph">
          Harbor is a white-label launcher that ships with your game. Every time a player hits
          Play, they pass through a screen you own: your news, your updates, your
          voice. <strong class="hero-key">And for the first time, your players' emails: an
          opt-in list you own, export, and keep.</strong>
        </p>

        <form id="waitlist-form" class="email-form">
          <p class="honeypot" aria-hidden="true">
            <label>Don't fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </p>
          <input
            type="email"
            name="email"
            placeholder="you@studio.com"
            required
            autocomplete="email"
            aria-label="Email address"
            class="input email-input"
          />
          <button type="submit" class="btn btn-primary btn-lg">Get access</button>
          <span class="form-error" id="waitlist-error" role="alert" hidden></span>
        </form>

        <div class="form-success" id="waitlist-success" role="status" tabindex="-1" hidden>
          <span class="pill pill-teal">
            <span class="pill-dot"></span>
            You're in.
          </span>
          <p class="form-success-msg">We'll reach out with your personal invite.</p>
        </div>
      </div>

      {/* Hero media: the explainer video behind a click-to-play facade. The
          poster is our own launcher capture, so nothing loads from YouTube
          (no scripts, no cookies) until a visitor presses play. */}
      <div class="hero-media">
        <div class="hero-media-stage">
          <div class="hero-media-frame" id="hero-video" data-video-id={HERO_VIDEO_ID}>
            <button type="button" class="hero-video-play" id="hero-video-play" aria-label="Play video: Harbor explained">
              <img src="/demo-poster.webp" alt="" width="1282" height="722" loading="eager" decoding="async" />
              <span class="hero-play-glyph" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13a1 1 0 0 0 1.52.85l10.4-6.5a1 1 0 0 0 0-1.7L9.52 4.65A1 1 0 0 0 8 5.5Z" /></svg>
              </span>
            </button>
          </div>
          <p class="hero-media-cap">Watch: Harbor explained</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Stat band ===== -->
  <ul class="stat-band" data-rv-group>
    <li data-rv><b aria-hidden="true">01</b>Customizable launcher</li>
    <li data-rv><b aria-hidden="true">02</b>No player accounts</li>
    <li data-rv><b aria-hidden="true">03</b>Skippable in one click</li>
    <li data-rv><b aria-hidden="true">04</b>Game launches as normal</li>
  </ul>

  <!-- ===== What is Harbor ===== -->
  <section class="what section-ink" id="what">
    <div class="container what-cols">
      <div data-rv style="--rv: translateX(-36px)">
        <span class="eyebrow">What is Harbor</span>
        <h2 class="what-title">A surface you own, at the moment that matters.</h2>
        <div class="row-list">
          {
            WHAT_BULLETS.map((b, i) => (
              <div class="row">
                <span class="row-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <h3 class="row-title">{b.title}</h3>
                  <p class="row-desc">{b.desc}</p>
                  {b.modules && (
                    <p class="row-modules">
                      {b.modules.map((m, j) => (
                        <>
                          <span class="row-module">{m}</span>
                          {j < b.modules!.length - 1 && (
                            <span class="row-module-sep" aria-hidden="true">
                              ·
                            </span>
                          )}
                        </>
                      ))}
                    </p>
                  )}
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div class="wf-flow" data-rv style="--rv: translateX(36px)" aria-label="The storefront launches Harbor, your branded launcher, which launches your game">
        <div class="wf-step">
          <span>Storefront</span>
          <span class="wf-sub">Steam · Epic · GOG</span>
        </div>
        <div class="wf-arrow" aria-hidden="true">↓</div>

        {/* Wireframe of the player-facing launcher: module tabs, news lines,
            a survey, email opt-in, social links, Play. Same skeleton idiom as
            the configurator wireframe on /how-it-works. Callout labels point
            at each module (desktop only; the Module-library row carries the
            names everywhere else). */}
        <div class="lw-wrap">
          <div class="launcher-wf panel-ink" role="img" aria-label="Wireframe of your branded launcher: module tabs, news posts, a survey, an email opt-in field, social links, and a Play button">
            <div class="lw-head">
              <span class="lw-dot"></span>
              <span class="lw-dot"></span>
              <span class="lw-dot"></span>
              <span class="lw-file mono">yourgame · your launcher</span>
            </div>
            <div class="lw-body">
              <div class="lw-tabs">
                <span class="lw-tab on"></span>
                <span class="lw-tab"></span>
                <span class="lw-tab"></span>
              </div>
              <span class="lw-title"></span>
              <span class="lw-line" style="width: 74%"></span>
              <span class="lw-line" style="width: 58%"></span>
              <div class="lw-survey">
                <span class="lw-line" style="width: 44%"></span>
                <span class="lw-opt"></span>
                <span class="lw-opt"></span>
                <span class="lw-opt"></span>
              </div>
              <div class="lw-footer">
                <span class="lw-input"></span>
                <span class="lw-play">Play</span>
              </div>
              <div class="lw-social">
                <span class="lw-soc"></span>
                <span class="lw-soc"></span>
                <span class="lw-soc"></span>
                <span class="lw-soc"></span>
              </div>
            </div>
          </div>
          <div class="lw-callouts" aria-hidden="true">
            <span class="lw-co" style="--co-top: 22%">News modules</span>
            <span class="lw-co" style="--co-top: 56%">Surveys</span>
            <span class="lw-co" style="--co-top: 74%">Email capture</span>
            <span class="lw-co" style="--co-top: 90%">Social links</span>
          </div>
        </div>

        <div class="wf-arrow" aria-hidden="true">↓</div>
        <div class="wf-step">
          <span>Your game</span>
          <span class="wf-sub">Launches as normal</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Why Harbor (+ the polarity flip, "The moment") ===== -->
  <WhyHarbor />

  <!-- ===== What you get back ===== -->
  <ValueProps />

  <!-- ===== Frictionless for players ===== -->
  <Frictionless />

  <!-- ===== CTA close ===== -->
  <section class="cta-close">
    <div class="container">
      <h2 class="cta-title" data-rv>Sell the game. <span class="text-teal">Keep the player.</span></h2>
      <form id="cta-form" class="email-form" data-rv style="--rvd: 0.12s">
        <p class="honeypot" aria-hidden="true">
          <label>Don't fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>
        <input
          type="email"
          name="email"
          placeholder="you@studio.com"
          required
          autocomplete="email"
          aria-label="Email address"
          class="input email-input"
        />
        <button type="submit" class="btn btn-primary btn-lg">Get access</button>
        <span class="form-error" id="cta-error" role="alert" hidden></span>
      </form>
      <div class="form-success" id="cta-success" role="status" tabindex="-1" hidden>
        <span class="pill pill-teal">
          <span class="pill-dot"></span>
          You're in.
        </span>
        <p class="form-success-msg">We'll reach out with your personal invite.</p>
      </div>
    </div>
  </section>

  <!-- ===== FAQ (minimal) ===== -->
  <section class="faq-min">
    <div class="container faq-min-row">
      <span class="eyebrow faq-min-eyebrow">FAQ</span>
      <p class="faq-min-copy">Pricing, storefront rules, player experience: answered.</p>
      <a href="/how-it-works#faq" class="btn btn-ghost">Read the FAQ →</a>
    </div>
  </section>
</Base>

<style>
  /* Structural-break hero (brand doc: felt-difference mandate). Viewport-scale
     type, asymmetric 5/7 grid, launcher bleeding off the right edge. */
  .hero-xl {
    background: var(--harbor-deep);
    padding: clamp(28px, 3vw, 48px) 0 0;
    overflow-x: clip; /* the bleed crops here — body must never scroll sideways */
    /* Landing view = header (65px) + hero + stat band (73px) in one viewport. */
    height: calc(100svh - 138px);
    min-height: 560px;
    display: flex;
    flex-direction: column;
  }
  .hero-display {
    font-family: var(--font-display-expanded);
    font-weight: 900;
    font-stretch: 125%;
    /* vh term keeps the landing view intact on short screens */
    font-size: clamp(48px, min(10.4vw, 13vh), 148px);
    line-height: 0.95;
    letter-spacing: -0.028em;
    color: var(--text);
    margin: 0 0 0 4vw;
    max-width: 96vw;
    text-wrap: balance;
    flex: none;
    /* The title always paints over the launcher when they interlock. */
    position: relative;
    z-index: 2;
  }
  .hd-alt {
    display: block;
    color: var(--teal);
  }
  .hero-cols {
    display: grid;
    grid-template-columns: minmax(320px, 5fr) 7fr;
    gap: 0 3vw;
    align-items: stretch;
    margin-top: clamp(20px, 2.5vw, 40px);
    flex: 1;
    min-height: 0;
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: 0 0 24px 4vw;
  }
  .hero-key {
    color: var(--teal);
    font-weight: 600;
  }
  .stat-band {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--harbor-line);
    border-bottom: 1px solid var(--harbor-line);
  }
  .stat-band li {
    padding: 18px 24px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text2);
    border-left: 1px solid var(--harbor-line);
  }
  .stat-band li:first-child {
    border-left: 0;
    padding-left: 4vw;
  }
  .stat-band b {
    display: block;
    color: var(--text3);
    font-weight: 400;
    margin-bottom: 3px;
  }
  .hero-media {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 0;
    padding-right: 4vw;
    /* Interlock: the video rises beside the short second headline line
       ("of Play."), filling the top-right void instead of floating below. */
    margin-top: clamp(-150px, -13vh, -48px);
    padding-bottom: clamp(24px, 3vw, 40px);
  }
  /* The stage is whatever space the locked-height hero leaves. A size
     container lets the 16:9 frame fit whichever axis runs out first; a video
     can't be cropped to fill like the old screenshot was, or YouTube's
     controls would be clipped. The caption lives in the stage so it follows
     the frame, and --cap-h reserves its height. */
  .hero-media-stage {
    --cap-h: 42px;
    flex: 1;
    min-height: 0;
    container-type: size;
  }
  .hero-media-frame {
    position: relative;
    width: min(100cqw, (100cqh - var(--cap-h)) * 16 / 9);
    aspect-ratio: 16 / 9;
    border: 1px solid var(--harbor-line-strong);
    border-radius: var(--r-md);
    overflow: hidden;
    background: var(--harbor-ink);
    box-shadow: -30px 40px 80px rgba(0, 0, 0, 0.5);
  }
  .hero-media-frame :global(iframe),
  .hero-video-play {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .hero-video-play {
    display: block;
    padding: 0;
    background: none;
    cursor: pointer;
  }
  .hero-video-play img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: filter var(--dur-base) var(--ease);
  }
  .hero-video-play:hover img {
    filter: brightness(0.82);
  }
  .hero-video-play:focus-visible {
    outline: 2px solid var(--teal);
    outline-offset: -4px;
  }
  .hero-play-glyph {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 76px;
    height: 76px;
    display: flex;
    align-items: center;
    justify-content: center;
    /* Optical centring: a play triangle reads left-heavy at true centre. */
    padding-left: 4px;
    border-radius: 50%;
    color: var(--teal-contrast);
    background: var(--teal);
    box-shadow: 0 10px 34px rgba(0, 0, 0, 0.5);
    transform: translate(-50%, -50%);
    transition: transform var(--dur-base) var(--ease);
  }
  .hero-video-play:hover .hero-play-glyph,
  .hero-video-play:focus-visible .hero-play-glyph {
    transform: translate(-50%, -50%) scale(1.08);
  }
  .hero-media-cap {
    flex: none;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-align: left;
    color: var(--text3);
    margin: 16px 0 0;
  }
  /* ----- What is Harbor: touchpoint rows + launcher wireframe flow ----- */
  .what {
    padding: clamp(72px, 8vw, 120px) 0;
  }
  .what :global(.what-cols) {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: 4vw;
    align-items: start;
  }
  .what-title {
    font-family: var(--font-display-expanded);
    font-stretch: 125%;
    font-weight: 900;
    font-size: clamp(28px, 3.4vw, 48px);
    line-height: 1.04;
    letter-spacing: -0.02em;
    color: var(--text);
    margin: 0 0 28px;
    text-wrap: balance;
  }
  /* Boxed numbers separate the What touchpoints (vs the Why section's
     accent-only numbers). */
  .what :global(.row-n) {
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 1px solid var(--harbor-line-strong);
    border-radius: var(--r-sm);
    font-size: 11px;
    color: var(--text2);
  }
  /* Module names in the Module-library row — the homepage's first feature
     reveal, so they stand out: bold, teal. */
  .what :global(.row-modules) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    row-gap: 4px;
    margin: 12px 0 0;
    line-height: 1.6;
  }
  .what :global(.row-module) {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 650;
    color: var(--teal);
    white-space: nowrap;
  }
  .what :global(.row-module-sep) {
    color: var(--text3);
    padding: 0 10px;
  }
  .wf-flow {
    display: flex;
    flex-direction: column;
    align-self: center; /* diagram centers against the taller text column */
  }
  .lw-wrap {
    position: relative;
  }
  .lw-callouts {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .lw-co {
    position: absolute;
    top: var(--co-top);
    right: calc(100% - 12px);
    transform: translateY(-50%);
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--teal);
    white-space: nowrap;
    /* Notch into the panel edge instead of reaching toward the text column,
       so the labels can never collide with the row copy. */
    background: var(--harbor-ink);
    padding: 3px 8px;
    border: 1px solid var(--teal-border);
    border-radius: var(--r-sm);
  }
  .lw-co::after {
    content: '';
    position: absolute;
    left: 100%;
    top: 50%;
    width: 14px;
    border-top: 1px solid var(--teal-border);
  }
  .wf-step {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text);
    border: 1px solid var(--harbor-line-strong);
    border-radius: var(--r-md);
    padding: 14px 18px;
  }
  .wf-sub {
    color: var(--text3);
    font-size: 11.5px;
  }
  .wf-arrow {
    font-family: var(--font-mono);
    color: var(--text3);
    padding: 8px 0 8px 20px;
  }
  /* Holographic set-piece treatment — sanctioned for this graphic only
     (brand doc amendment 2026-07-26). */
  .launcher-wf {
    position: relative;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--teal) 7%, transparent), transparent 45%),
      var(--harbor-deep);
    border: 1px solid var(--teal-border);
    border-radius: var(--r-lg);
    overflow: hidden;
    box-shadow:
      0 0 0 1px var(--teal-sheen),
      0 0 48px var(--teal-holo),
      inset 0 0 34px color-mix(in srgb, var(--teal) 5%, transparent);
  }
  .launcher-wf::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      115deg,
      transparent 32%,
      var(--teal-sheen) 47%,
      transparent 62%
    );
    pointer-events: none;
  }
  .lw-head {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 11px 14px;
    border-bottom: 1px solid var(--harbor-line);
  }
  .lw-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--bg4);
  }
  .lw-file {
    margin-left: 8px;
    font-size: 11.5px;
    color: var(--text2);
  }
  .lw-body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 18px;
    min-height: 220px;
  }
  .lw-tabs {
    display: flex;
    gap: 8px;
    margin-bottom: 4px;
  }
  .lw-tab {
    width: 54px;
    height: 20px;
    border-radius: var(--r-sm);
    background: color-mix(in srgb, var(--teal) 9%, transparent);
  }
  .lw-tab.on {
    background: var(--teal-bg);
    border: 1px solid var(--teal-border);
  }
  .lw-title {
    display: block;
    width: 46%;
    height: 13px;
    border-radius: 5px;
    background: color-mix(in srgb, var(--teal) 38%, transparent);
  }
  .lw-line {
    display: block;
    height: 8px;
    border-radius: 4px;
    background: color-mix(in srgb, var(--teal) 14%, transparent);
  }
  .lw-survey {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
  }
  .lw-survey .lw-line {
    margin-right: 6px;
  }
  .lw-opt {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 1px solid var(--teal-border);
    background: color-mix(in srgb, var(--teal) 6%, transparent);
  }
  .lw-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-top: auto;
    padding-top: 14px;
  }
  .lw-social {
    display: flex;
    gap: 8px;
    padding-top: 12px;
  }
  .lw-soc {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--teal) 14%, transparent);
  }
  .lw-input {
    flex: 1;
    height: 26px;
    border-radius: var(--r-sm);
    border: 1px solid var(--teal-border);
    background: var(--harbor-ink);
  }
  .lw-play {
    font-family: var(--font-body);
    font-size: 12.5px;
    font-weight: 650;
    color: var(--teal-contrast);
    background: var(--teal);
    border-radius: var(--r-sm);
    padding: 6px 18px;
  }

  /* ----- CTA close + minimal FAQ ----- */
  .cta-close {
    background: var(--harbor-ink);
    border-top: 1px solid var(--harbor-line);
    padding: clamp(72px, 9vw, 130px) 0;
  }
  .cta-title {
    font-family: var(--font-display-expanded);
    font-stretch: 125%;
    font-weight: 900;
    font-size: clamp(38px, 6.6vw, 96px);
    line-height: 0.98;
    letter-spacing: -0.026em;
    color: var(--text);
    margin: 0 0 34px;
    max-width: 14ch;
    text-wrap: balance;
  }
  .faq-min {
    border-top: 1px solid var(--harbor-line);
    padding: 40px 0;
  }
  .faq-min :global(.faq-min-row) {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }
  .faq-min-eyebrow {
    margin-bottom: 0;
  }
  .faq-min-copy {
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--text2);
    margin: 0;
    flex: 1;
    min-width: 240px;
  }

  @media (max-width: 980px) {
    /* Stacked layout can't honestly fit one viewport — release the lock. */
    .hero-xl {
      height: auto;
      min-height: 0;
    }
    .hero-cols {
      grid-template-columns: 1fr;
      gap: 0;
      margin-top: 8px;
    }
    .hero-copy {
      padding-bottom: 44px;
      /* Stacked, nothing sits to the right any more, so the column needs the
         same 4vw gutter on both sides. Without this the form and paragraph
         run flush into the right screen edge. */
      padding-right: 4vw;
      justify-content: flex-start;
    }
    /* TRIAL (Robin, looking at this): centred hero copy on the stacked layout.
       Headline centres too so it shares an edge with the paragraph instead of
       sitting left while the body centres. Revert both to left if it doesn't
       land. Mobile only: desktop keeps the asymmetric composition. */
    .hero-display {
      margin-left: 0;
      max-width: none;
      padding: 0 4vw;
      text-align: center;
      /* Larger than the shared clamp gives at phone widths (that floor lands
         on 48px at 375). 15vw grows it with the screen; the 7vh term pulls it
         back on short viewports so the form keeps its shot at the fold. */
      font-size: clamp(40px, min(15vw, 7vh), 72px);
    }
    .hero-paragraph {
      text-align: center;
      margin-bottom: 14px;
    }
    /* Stacked, there is no headline void to rise into, and the interlock's
       negative margin dragged the launcher up over the form's submit button
       (unreachable: taps hit the image). Sit below the copy with breathing
       room, inset to the same 4vw gutter as .hero-copy. */
    .hero-media {
      margin-top: 0;
      padding: 8px 4vw 10px;
      flex: none;
      /* TRIAL: Title -> Photo -> Body -> Form. The media is the second grid
         item in source order; this lifts it above the copy visually. See the
         focus-order caveat noted to Robin before this ships. */
      order: -1;
    }
    /* Stacked, the hero height is unlocked, so the frame takes the full
       column width and its height from the 16:9 ratio. */
    .hero-media-stage {
      flex: none;
      container-type: normal;
    }
    .hero-media-frame {
      width: 100%;
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
    }
    .hero-play-glyph {
      width: 60px;
      height: 60px;
    }
    .hero-media-cap {
      margin: 8px 0 4px;
    }
    .stat-band {
      grid-template-columns: 1fr 1fr;
    }
    .stat-band li {
      border-left: 0;
      padding-left: 4vw;
    }
    .stat-band li:nth-child(n + 3) {
      border-top: 1px solid var(--harbor-line);
    }
  }
  @media (max-width: 640px) {
    /* Brand doc mobile strategy: narrow the width axis before shrinking size. */
    .hero-display {
      font-stretch: 100%;
      letter-spacing: -0.02em;
    }
  }
  /* Phone widths. 540px, not 420: the largest iPhones are 428-440 CSS px
     (Plus 428, Pro Max 430, 16 Pro Max 440), so a narrower breakpoint leaves
     them on the desktop-ish layout. Force the input to own its line so the
     button always drops beneath it and centres; relying on natural flex wrap
     only triggered below ~394px, which is why big phones missed it. */
  @media (max-width: 540px) {
    #waitlist-form {
      justify-content: center;
    }
    #waitlist-form .email-input {
      flex: 0 0 100%;
    }
    /* Two thirds of the form width: a deliberate target on its own line,
       rather than a small auto-width button floating under a full-width field. */
    #waitlist-form .btn {
      flex: 0 0 66.6667%;
    }
  }
  @media (max-width: 980px) {
    .what :global(.what-cols) {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
  @media (max-width: 1200px) {
    /* Not enough gap for the pointer labels; the Module-library row names
       the modules everywhere, so the callouts are desktop garnish. */
    .lw-callouts {
      display: none;
    }
  }
  @media (max-width: 760px) {
    .cta-close {
      padding: 56px 0;
    }
  }
</style>

<script>
  import { wireForm } from '../lib/waitlist-form';
  import { initReveal } from '../lib/reveal';

  wireForm('waitlist-form', 'waitlist-success', 'waitlist-error', 'hero');
  wireForm('cta-form', 'cta-success', 'cta-error', 'footer-cta');

  // Directional scroll entrances — shared implementation in src/lib/reveal.ts.
  initReveal();

  // Hero video facade. The privacy-enhanced (nocookie) player is only
  // created on press, so visitors who never play it load nothing from YouTube.
  const videoFrame = document.getElementById('hero-video');
  const playBtn = document.getElementById('hero-video-play');
  const videoId = videoFrame?.dataset.videoId;
  if (videoFrame && playBtn && videoId) {
    playBtn.addEventListener(
      'click',
      () => {
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(videoId)}?autoplay=1&rel=0&playsinline=1`;
        iframe.title = 'Harbor explained';
        iframe.allow = 'autoplay; encrypted-media; fullscreen; picture-in-picture; web-share';
        iframe.allowFullscreen = true;
        iframe.referrerPolicy = 'strict-origin-when-cross-origin';
        playBtn.replaceWith(iframe);
        iframe.focus();
        window.posthog?.capture('hero_video_play');
      },
      { once: true },
    );
  }
</script>
